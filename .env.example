# Local PostgreSQL connection string. The database initializer uses this value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional pooled connection string for the app.
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Generate separate random values for these secrets. Do not commit real values.
BETTER_AUTH_SECRET=replace-with-a-generated-random-secret
BETTER_AUTH_URL=http://localhost:3000
ENCRYPTION_KEY=replace-with-a-separate-stable-random-secret

# Resend API key from the Resend dashboard. Keep it secret.
RESEND_API_KEY=re_your_api_key

# Sender address on a domain verified with Resend.
AUTH_EMAIL_FROM=Ledger <passwords@your-verified-domain.com>

# Vercel Cron uses this to authenticate the recurring-transaction job.
# Generate a random secret and add it to Vercel before enabling scheduled rules.
CRON_SECRET=replace-with-a-generated-random-secret
